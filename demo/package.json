{
  "name": "quotabar-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The bilingual hand-drawn QuotaBar Film.",
  "engines": {"node": ">=22"},
  "scripts": {
    "build": "tsx scripts/build.ts",
    "studio": "remotion studio video/index.ts --public-dir video/public",
    "timeline:export": "tsx scripts/export-timeline.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project timeline",
    "test:film": "vitest run --project film",
    "test:audio": "uv run --project audio pytest audio/tests -q",
    "test:all": "npm run typecheck && npm test && npm run test:audio && npm run test:film"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4.0.529",
    "@remotion/renderer": "4.0.529",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.529",
    "roughjs": "4.6.6"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.2"
  }
}
